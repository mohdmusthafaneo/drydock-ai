{
  "name": "aidos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "worker": "tsx scripts/agent-worker-loop.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:prod": "prisma migrate deploy && node server.js",
    "lint": "eslint",
    "test:agent-presentation": "tsx --test src/lib/agent-analysis/presentation.test.ts",
    "test:briefing": "tsx --test src/lib/executive-briefing/*.test.ts",
    "test:agent-chat": "tsx --test src/lib/agent-chat/context.test.ts src/lib/agent-chat/index.test.ts",
    "test:env": "tsx --test src/lib/env.test.ts",
    "test:json-field": "tsx --test src/lib/json-field.test.ts",
    "test:prisma-tenant": "tsx --test src/lib/prisma-tenant.test.ts",
    "test:mastra": "tsx --test src/mastra/config/models.test.ts",
    "mastra:studio": "MASTRA_DEV=1 mastra dev -d src/mastra --request-context-presets ./mastra-request-context-presets.json",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "sanitize:landing": "node scripts/sanitize-portkey-html.mjs",
    "build:landing": "node scripts/build-landing-assets.mjs && node scripts/patch-landing-html.mjs && node scripts/optimize-landing.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cloudtrail": "^3.1097.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1097.0",
    "@aws-sdk/client-config-service": "^3.1097.0",
    "@aws-sdk/client-ec2": "^3.1097.0",
    "@aws-sdk/client-ecs": "^3.1097.0",
    "@aws-sdk/client-eks": "^3.1097.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1097.0",
    "@aws-sdk/client-iam": "^3.1097.0",
    "@aws-sdk/client-lambda": "^3.1097.0",
    "@aws-sdk/client-rds": "^3.1097.0",
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/client-sts": "^3.1097.0",
    "@chat-adapter/slack": "^4.36.0",
    "@mastra/core": "^1.42.0",
    "@mastra/loggers": "^1.1.2",
    "@mastra/memory": "^1.20.3",
    "@mastra/observability": "^1.16.0",
    "@mastra/pg": "^1.15.1",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tanstack/react-query": "^5.101.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.6",
    "mastra": "^1.13.0",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "pg-boss": "^12.25.1",
    "pino": "^10.3.1",
    "prisma": "^7.8.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "simple-git": "^3.36.0",
    "tailwind-merge": "^3.6.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "js-yaml": "^4.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.1",
    "typescript": "^5"
  }
}
