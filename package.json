{
  "name": "aidos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "worker:agents": "tsx scripts/agent-worker-loop.ts",
    "worker:cron": "tsx scripts/cron-loop.ts",
    "db:backfill-chat-md": "tsx scripts/backfill-agent-chat-md.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:prod": "prisma migrate deploy && node server.js",
    "lint": "eslint",
    "test:agent-chat": "tsx --test src/lib/agent-chat/context.test.ts",
    "test:mastra": "tsx --test src/mastra/tools/aidos/toolsets.test.ts src/mastra/tools/aidos/tools.test.ts src/lib/mastra-feature-flags.test.ts",
    "load-test:chat-wakeups": "tsx scripts/load-test-chat-wakeups.ts",
    "mastra:studio": "mastra dev -d src/mastra/examples",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "sanitize:landing": "node scripts/sanitize-portkey-html.mjs",
    "build:landing": "node scripts/build-landing-assets.mjs && node scripts/patch-landing-html.mjs && node scripts/optimize-landing.mjs"
  },
  "dependencies": {
    "@mastra/core": "^1.42.0",
    "@mastra/duckdb": "^1.4.2",
    "@mastra/libsql": "^1.13.0",
    "@mastra/loggers": "^1.1.2",
    "@mastra/memory": "^1.20.3",
    "@mastra/observability": "^1.14.1",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.101.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "mastra": "^1.13.0",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "js-yaml": "^4.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.1",
    "typescript": "^5"
  }
}
