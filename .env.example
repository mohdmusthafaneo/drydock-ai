# Database (PostgreSQL)
DATABASE_URL="postgresql://aidos:aidos_dev_password@localhost:5432/aidos?schema=public"

# Auth
AUTH_SECRET="generate-a-random-32-character-secret"

# Platform worker — external cron calls POST /api/platform/jira/sync (Bearer token)
# Also used by POST /api/platform/agents/worker for agent heartbeat drain
PLATFORM_WORKER_SECRET=""

# Agent control plane (Phase 5a)
AGENT_WORKER_ENABLED="true"
AGENT_DEFAULT_HEARTBEAT_SEC="900"
# OPENAI_API_KEY=""  # Phase 5b — BYOK for internal LLM adapter

# App — required for OAuth redirects and external setup links (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GitHub App — https://github.com/settings/apps → New GitHub App
# Public page:   https://github.com/apps/<slug>
# Setup URL:     http://localhost:3000/api/integrations/external/github/callback
# (Legacy app-callback: http://localhost:3000/api/integrations/github/app-callback)
GITHUB_APP_SLUG="aidos-neo"
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# GitHub OAuth (legacy — not used for sync or code analysis)

# Jira Cloud (Atlassian OAuth 3LO) — https://developer.atlassian.com/console/myapps/
# Callback URLs (add both for in-app and external share-link flows):
#   http://localhost:3000/api/integrations/jira/callback
#   http://localhost:3000/api/integrations/external/jira/callback
# In the app Permissions tab, enable read scopes (see docs/jira-integration.md §6.1)
ATLASSIAN_CLIENT_ID=""
ATLASSIAN_CLIENT_SECRET=""