# Database (PostgreSQL + TimescaleDB + pgvector)
DATABASE_URL="postgresql://aidos:aidos_dev_password@localhost:5432/aidos?schema=public"

# Shared cache (Phase 5) — leave unset for in-memory single-replica
# VALKEY_URL="redis://localhost:6379"

# Optional analytics read replica (Phase 5) — omit to use DATABASE_URL
# DATABASE_URL_REPLICA="postgresql://aidos:aidos_dev_password@localhost:5433/aidos?schema=public"

# Auth
AUTH_SECRET="generate-a-random-32-character-secret"

# Platform worker — optional manual trigger via POST /api/cron/* (Bearer token)
# Scheduled jobs run on pg-boss via AIDOS_PROCESS_ROLE=worker (or web schedules + worker consumes)
PLATFORM_WORKER_SECRET=""

# Overview demo fixture (Connexus dummy data). On by default in all envs.
# Set to 0/false for live Overview loaders. Or use ?fixture=0 in the URL.
# DRYDOCK_OVERVIEW_FIXTURE="1"

# Docker image process role: web (default) or worker
# AIDOS_PROCESS_ROLE="web"
# AIDOS_PROCESS_ROLE="worker"
# Worker only — internal URL of the web service
# AIDOS_API_URL="http://localhost:3000"
# Split pools (Phase 5): refresh | enrich | ml | retention | all
# WORKER_QUEUES="all"

# Anthropic Messages API — MiniMax-compatible endpoint
ANTHROPIC_BASE_URL="https://api.minimax.io/anthropic"
ANTHROPIC_API_KEY=""  # Required — set in local .env only, never commit
ANTHROPIC_MODEL="MiniMax-M3"

# Mastra storage (Phase 1a) — Postgres via DATABASE_URL; optional schema override
# MASTRA_PG_SCHEMA="mastra"

# Scheduled refresh of QA / DevOps / productivity / governance agents (Mastra workflow cron)
# Default: every 6 hours UTC. Set AGENT_ANALYSIS_SCHEDULE_ENABLED=false to disable.
# AGENT_ANALYSIS_CRON="0 */6 * * *"
# AGENT_ANALYSIS_TIMEZONE="UTC"
# AGENT_ANALYSIS_SCHEDULE_ENABLED="true"
# Manual trigger: POST /api/cron/agent-analysis/refresh (Bearer PLATFORM_WORKER_SECRET)

# Governance agent — optional path to repowise CLI (defaults to `repowise` on PATH)
# REPOWISE_BIN="repowise"

# DevOps agent — operator AWS credentials must sts:AssumeRole into customer roles
# TRUSTED_AWS_ACCOUNT_ID=""
# AWS_REGION="us-east-1"
# AWS_PROFILE=""
# Or instead of profile:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Executive briefing LLM enrichment (pg-boss schedule on worker)
# EXECUTIVE_BRIEFING_ENRICH_ENABLED="true"
# EXECUTIVE_BRIEFING_ENRICH_INTERVAL_SEC="7200"

# Problem predictor baseline eval interval (pg-boss)
# PREDICTIONS_EVAL_INTERVAL_SEC="3600"

# pg-boss scheduled job intervals (seconds — converted to cron at boot)
# JIRA_SYNC_INTERVAL_SEC="900"
# CODE_ANALYSIS_ENRICH_INTERVAL_SEC="900"
# COMPLIANCE_EVAL_INTERVAL_SEC="1800"
# JIRA_CALIBRATE_INTERVAL_SEC="86400"

AIDOS_API_URL="http://localhost:3000"  # Agent adapter → API tool calls (defaults to NEXT_PUBLIC_APP_URL)

# Agent chat threads (Phase 5.6)
AGENT_CHAT_CONTEXT_LIMIT="20"

# App — required for OAuth redirects and external setup links (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GitHub App
# Public page:   https://github.com/apps/<slug>
# Setup URL:     http://localhost:3000/api/integrations/external/github/callback
# (Legacy app-callback: http://localhost:3000/api/integrations/github/app-callback)
GITHUB_APP_SLUG="aidos-neo"
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# GitHub OAuth (legacy — not used for sync or code analysis)

# Jira Cloud (Atlassian OAuth 3LO) — https://developer.atlassian.com/console/myapps/
# Callback URLs (add both for in-app and external share-link flows):
#   http://localhost:3000/api/integrations/jira/callback
#   http://localhost:3000/api/integrations/external/jira/callback
# In the app Permissions tab, enable read scopes (see docs/jira-integration.md §6.1)
ATLASSIAN_CLIENT_ID=""
ATLASSIAN_CLIENT_SECRET=""

# Slack (multi-workspace OAuth + Events API) — https://api.slack.com/apps
# Callback URLs (add both for in-app and external share-link flows):
#   http://localhost:3000/api/integrations/slack/callback
#   http://localhost:3000/api/integrations/external/slack/callback
# Event Subscriptions Request URL:
#   http://localhost:3000/api/webhooks/slack
# Bot Token Scopes: app_mentions:read, chat:write, im:history, im:read, im:write,
#   channels:history, channels:read, groups:history, groups:read, users:read,
#   users:read.email, assistant:write
# Subscribe to bot events: app_mention, message.im
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""
# Optional: max Slack assistant turns per org per hour (default 30)
# SLACK_ASSISTANT_HOURLY_LIMIT="30"
