# Database (PostgreSQL)
DATABASE_URL="postgresql://aidos:aidos_dev_password@localhost:5432/aidos?schema=public"

# Auth
AUTH_SECRET="generate-a-random-32-character-secret"

# Platform worker — external cron calls POST /api/cron/jira/sync (Bearer token)
# Also used by POST /api/cron/agents/worker for agent heartbeat drain
# Legacy /api/platform/* rewrites to /api/cron/* (Next.js 16 + (platform) route group)
# Must match on web + worker containers when using split deploy
PLATFORM_WORKER_SECRET=""

# Docker / Coolify: web (default) or worker (agent heartbeat loop)
# AIDOS_PROCESS_ROLE="web"
# AIDOS_PROCESS_ROLE="worker"
# Worker only — internal URL of the web service (Coolify service name or http://web:3000)
# AIDOS_API_URL="http://web:3000"

# Agent control plane (Phase 5 — LLM + skills model)
AGENT_WORKER_ENABLED="true"
AGENT_WORKER_INTERVAL_SEC="15"
AGENT_DEFAULT_HEARTBEAT_SEC="900"
# Local dev: relative path under project root. Docker/Coolify default: /data/agent-instructions
AGENT_INSTRUCTIONS_ROOT=".data/agent-instructions"

# Anthropic Messages API (Phase 5.2+) — MiniMax-compatible endpoint
ANTHROPIC_BASE_URL="https://api.minimax.io/anthropic"
ANTHROPIC_API_KEY=""  # Required — set in local .env only, never commit
ANTHROPIC_MODEL="MiniMax-M3"

AIDOS_API_URL="http://localhost:3000"  # Agent adapter → API tool calls (defaults to NEXT_PUBLIC_APP_URL)

# Agent chat threads (Phase 5.6)
AGENT_CHAT_CONTEXT_LIMIT="20"

# App — required for OAuth redirects and external setup links (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GitHub App
# Public page:   https://github.com/apps/<slug>
# Setup URL:     http://localhost:3000/api/integrations/external/github/callback
# (Legacy app-callback: http://localhost:3000/api/integrations/github/app-callback)
GITHUB_APP_SLUG="aidos-neo"
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# GitHub OAuth (legacy — not used for sync or code analysis)

# Jira Cloud (Atlassian OAuth 3LO) — https://developer.atlassian.com/console/myapps/
# Callback URLs (add both for in-app and external share-link flows):
#   http://localhost:3000/api/integrations/jira/callback
#   http://localhost:3000/api/integrations/external/jira/callback
# In the app Permissions tab, enable read scopes (see docs/jira-integration.md §6.1)
ATLASSIAN_CLIENT_ID=""
ATLASSIAN_CLIENT_SECRET=""
