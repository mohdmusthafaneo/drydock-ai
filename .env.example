DATABASE_URL="file:./prisma/dev.db"
AUTH_SECRET="generate-a-random-32-character-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GitHub OAuth — https://github.com/settings/developers → New OAuth App
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3000/api/integrations/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub webhook HMAC secret (same value you enter in GitHub webhook settings)
GITHUB_WEBHOOK_SECRET=""

# Repos to pull PRs + Actions from on sync (comma-separated). Example production app:
# GITHUB_SYNC_REPOS="happilee-app/frontend_web"
