enum DevOpsAccountScanRunStatus {
  PERSISTED
  VERIFIED
  FAILED
}

enum DevOpsHygieneSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

model DevOpsAccountScanRun {
  id             String @id @default(cuid())
  organizationId String

  accountId String
  roleArn String

  regionsCount Int?
  durationMs Int?

  reportSha256 String

  analyzedAt DateTime @default(now())
  status DevOpsAccountScanRunStatus @default(PERSISTED)
  verifiedAt DateTime?
  verificationErrorsJson Json @default("[]")

  headlineResourcesCount Int?
  headlineFindingsCount Int?
  headlineWarningsCount Int?

  severityStats     DevOpsSeverityStat[]
  resourceTypeStats DevOpsResourceTypeStat[]
  resources         DevOpsResourceInventory[]
  hygieneFindings   DevOpsHygieneFinding[]
  warnings          DevOpsAccountScanWarning[]

  @@unique([organizationId, accountId, roleArn, reportSha256])
  @@index([organizationId, analyzedAt])
}

model DevOpsSeverityStat {
  id             String @id @default(cuid())
  organizationId String
  runId          String

  severity DevOpsHygieneSeverity
  count Int

  run DevOpsAccountScanRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, severity])
  @@index([organizationId, severity])
}

model DevOpsResourceTypeStat {
  id             String @id @default(cuid())
  organizationId String
  runId          String

  resourceType String
  count Int

  run DevOpsAccountScanRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, resourceType])
  @@index([organizationId, resourceType])
}

model DevOpsResourceInventory {
  id             String @id @default(cuid())
  organizationId String
  runId          String

  resourceType String
  resourceId String
  region String?
  name String?
  arn String?

  run DevOpsAccountScanRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, resourceType, resourceId, region])
  @@index([organizationId, resourceType, region])
}

model DevOpsHygieneFinding {
  id             String @id @default(cuid())
  organizationId String
  runId          String

  rank Int
  checkId String
  severity DevOpsHygieneSeverity

  title String
  description String
  recommendation String

  resourceType String?
  resourceRef String?

  run DevOpsAccountScanRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  // Rank is the stable per-run ordering from the scanner; checkId+resourceRef can collide.
  @@unique([runId, rank])
  @@index([organizationId, severity])
  @@index([runId, checkId])
}

model DevOpsAccountScanWarning {
  id             String @id @default(cuid())
  organizationId String
  runId          String

  rank Int
  warningText String

  run DevOpsAccountScanRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, warningText])
  @@index([organizationId, runId])
}
