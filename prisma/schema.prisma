generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ORG_ADMIN
  DELIVERY_MANAGER
  ENGINEERING_MANAGER
  QA_LEAD
  DEVOPS_LEAD
  DEVELOPER
  VIEWER
  COMPLIANCE_OFFICER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AutonomyMode {
  OBSERVE
  RECOMMEND
  ASSIST
  SEMI_AUTONOMOUS
  AUTONOMOUS
}

enum IntegrationProvider {
  GITHUB
  JIRA
  JENKINS
  GRAFANA
  PROMETHEUS
  SLACK
}

enum TelemetryEventType {
  DEPLOYMENT
  CICD
  RELEASE
  OBSERVABILITY
  AI_RUNTIME
  WEBHOOK
  CUSTOM
}

enum TelemetrySeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

enum RecommendationStatus {
  PENDING
  APPROVED
  REJECTED
  MODIFIED
}

enum RecommendationImpact {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  MODIFIED
}

enum WorkspaceMode {
  MVP
  ENTERPRISE
}

model Organization {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  industry      String?
  workspaceMode WorkspaceMode @default(MVP)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  users              User[]
  profile            OrganizationProfile?
  deliveryDna        DeliveryDNA?
  integrations       Integration[]
  recommendations    Recommendation[]
  approvals          Approval[]
  auditLogs          AuditLog[]
  activityEvents     ActivityEvent[]
  acceleratorProjects AcceleratorProject[]
  releases           Release[]
  deliveryWorkflow   DeliveryWorkflow?
  agents             AgentRegistry[]
  incidents          Incident[]
  telemetryMetrics   TelemetryMetric[]
  telemetryEvents    TelemetryEvent[]
  deploymentEvents   DeploymentEvent[]
  webhookEvents      WebhookEvent[]
  invitations        OrgInvitation[]
  governancePolicy   GovernancePolicy?
  codeAnalysisRuns   CodeAnalysisRun[]
  codeAnalysisCommits CodeAnalysisCommit[]
  codeAnalysisPullRequests CodeAnalysisPullRequest[]
  integrationConnectInvites IntegrationConnectInvite[]
  deliveryAnalysisSnapshots DeliveryAnalysisSnapshot[]
}

enum MetricSource {
  PROMETHEUS
  GRAFANA
  OPENTELEMETRY
  SYNTHETIC
}

enum DeploymentHealth {
  HEALTHY
  DEGRADED
  FAILED
}

model TelemetryMetric {
  id             String       @id @default(cuid())
  organizationId String
  releaseId      String?
  source         MetricSource
  metricKey      String
  value          Float
  unit           String?
  labelsJson     String       @default("{}")
  recordedAt     DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  release      Release?     @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@index([organizationId, recordedAt])
  @@index([releaseId])
}

model TelemetryEvent {
  id             String             @id @default(cuid())
  organizationId String
  eventType      TelemetryEventType
  source         String
  severity       TelemetrySeverity  @default(INFO)
  environment    String?
  service        String?
  releaseId      String?
  correlationId  String?
  normalizedJson String             @default("{}")
  payloadJson    String             @default("{}")
  occurredAt     DateTime
  ingestedAt     DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  release      Release?     @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([eventType])
  @@index([correlationId])
}

model WebhookEvent {
  id             String              @id @default(cuid())
  organizationId String
  provider       IntegrationProvider
  eventType      String
  status         WebhookEventStatus  @default(RECEIVED)
  payloadJson    String
  retryCount     Int                 @default(0)
  lastError      String?
  processedAt    DateTime?
  receivedAt     DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, receivedAt])
  @@index([status])
}

model OrgInvitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           UserRole @default(VIEWER)
  invitedById    String
  token          String   @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
}

model GovernancePolicy {
  id                    String   @id @default(cuid())
  organizationId        String   @unique
  deploymentThresholds  String   @default("{}")
  releaseRulesJson      String   @default("{}")
  approvalRequirements  String   @default("{}")
  escalationChainsJson  String   @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model DeploymentEvent {
  id                  String           @id @default(cuid())
  organizationId      String
  releaseId           String?
  environment         ReleaseEnvironment @default(STAGING)
  health              DeploymentHealth @default(HEALTHY)
  healthScore         Int              @default(100)
  rollbackRecommended Boolean          @default(false)
  rollbackReason      String?
  durationMs          Int?
  notes               String?
  deployedAt          DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  release      Release?     @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

enum WorkflowExecutionStatus {
  NOT_CONFIGURED
  ACTIVE
  PAUSED
  COMPLETED
}

enum AgentType {
  SUPER_ORCHESTRATOR
  QA_INTELLIGENCE
  DEVOPS_INTELLIGENCE
  GOVERNANCE
  INCIDENT_CORRELATION
  INTEGRATION
}

enum AgentStatus {
  IDLE
  ACTIVE
  DEGRADED
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  REMEDIATED
  CLOSED
}

model DeliveryWorkflow {
  id                 String                    @id @default(cuid())
  organizationId     String                    @unique
  workflowType       String                    @default("enterprise-governed")
  executionStatus    WorkflowExecutionStatus   @default(NOT_CONFIGURED)
  currentStepId      String?
  stepsCompletedJson String                    @default("[]")
  configuredAt       DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AgentRegistry {
  id             String      @id @default(cuid())
  organizationId String
  agentType      AgentType
  displayName    String
  description    String?
  status         AgentStatus @default(IDLE)
  confidenceScore Float      @default(0.85)
  autonomyMode   AutonomyMode @default(RECOMMEND)
  lastActiveAt   DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, agentType])
}

model Incident {
  id                   String         @id @default(cuid())
  organizationId       String
  releaseId            String?
  correlationId        String?
  source               MetricSource?
  title                String
  description          String?
  affectedServicesJson String         @default("[]")
  severityScore        Int            @default(50)
  status               IncidentStatus @default(OPEN)
  remediationNotes     String?
  detectedAt           DateTime       @default(now())
  resolvedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  release      Release?     @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([correlationId])
}

enum ReleaseEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum ReleaseStatus {
  DETECTED
  ASSESSED
  PENDING_APPROVAL
  APPROVED
  DEPLOYED
  BLOCKED
}

enum ReleaseRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PrimaryRecommendation {
  HOLD
  APPROVE_WITH_SIGNOFF
  APPROVE
}

model Release {
  id                   String              @id @default(cuid())
  organizationId       String
  name                 String
  version              String?
  branch               String?
  jiraFixVersion       String?
  serviceScope         String?
  environment          ReleaseEnvironment  @default(STAGING)
  status               ReleaseStatus       @default(DETECTED)
  governanceRiskScore  Float?
  readinessScore       Float?
  riskLevel            ReleaseRiskLevel?
  primaryRecommendation PrimaryRecommendation?
  qaSignalsJson        String              @default("[]")
  telemetryJson        String              @default("{}")
  testGapsJson         String              @default("[]")
  regressionNotes      String?
  assessmentSummary    String?
  assessmentSnapshotJson String            @default("{}")
  postDeployComparisonJson String          @default("{}")
  detectedAt           DateTime            @default(now())
  assessedAt           DateTime?
  deployedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendations  Recommendation[]
  incidents        Incident[]
  telemetryMetrics TelemetryMetric[]
  telemetryEvents  TelemetryEvent[]
  deploymentEvents DeploymentEvent[]

  @@index([organizationId])
}

enum AcceleratorStep {
  IDEA
  PRD
  ARCHITECTURE
  FEATURES
  JIRA_EPICS
  QA_PLAN
  DEPLOYMENT
  COMPLETE
}

enum AcceleratorStatus {
  DRAFT
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
}

model AcceleratorProject {
  id                    String            @id @default(cuid())
  organizationId        String
  title                 String
  idea                  String
  targetUser            String?
  problemStatement      String?
  currentStep           AcceleratorStep   @default(IDEA)
  status                AcceleratorStatus @default(DRAFT)
  prdMarkdown           String?
  architectureMarkdown  String?
  featuresJson          String            @default("[]")
  jiraEpicsJson         String            @default("[]")
  qaPlanMarkdown        String?
  deploymentPlanMarkdown String?
  roadmapJson           String            @default("[]")
  createdById           String?
  approvedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id])

  @@index([organizationId])
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String
  passwordHash   String
  role           UserRole   @default(DEVELOPER)
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  organizationId String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvals      Approval[]   @relation("Approver")
  auditLogs      AuditLog[]
  acceleratorProjects AcceleratorProject[]
}

model OrganizationProfile {
  id               String   @id @default(cuid())
  organizationId   String   @unique
  industryType     String?
  teamSize         String?
  sdlcMaturity     Int      @default(2)
  devopsMaturity   Int      @default(2)
  governanceLevel  Int      @default(2)
  complianceType   String?
  deploymentStrategy String?
  toolsJson        String   @default("[]")
  workflowsJson    String   @default("[]")
  toolchainMappingJson String @default("{}")
  toolchainMappingConfirmedAt DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model DeliveryDNA {
  id                String       @id @default(cuid())
  organizationId    String       @unique
  workflowMode      String
  approvalLevel     Int
  riskThreshold     Float
  autonomyMode      AutonomyMode @default(RECOMMEND)
  autonomyLevel     Int          @default(1)
  governanceScore   Int
  escalationMatrix  String       @default("{}")
  observabilityStrategy String?
  summary           String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Integration {
  id                String              @id @default(cuid())
  organizationId    String
  provider          IntegrationProvider
  status            IntegrationStatus   @default(PENDING)
  displayName       String?
  metadataJson      String              @default("{}")
  connectedAt       DateTime?
  lastSyncAt        DateTime?
  lastHealthCheckAt DateTime?
  lastError         String?
  webhookEnabled    Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

model IntegrationConnectInvite {
  id             String              @id @default(cuid())
  organizationId String
  provider       IntegrationProvider
  token          String              @unique
  createdById    String
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  revokedById    String?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider])
  @@index([expiresAt])
}

model Recommendation {
  id             String               @id @default(cuid())
  organizationId String
  releaseId      String?
  title          String
  description    String
  rationale      String
  impact         RecommendationImpact @default(MEDIUM)
  confidence     Float
  affectedSystems String              @default("[]")
  requiredRole   UserRole?
  status         RecommendationStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  release      Release?     @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  approvals    Approval[]
}

model Approval {
  id               String           @id @default(cuid())
  organizationId   String
  recommendationId String
  approverId       String?
  decision         ApprovalDecision?
  riskScore        Float?
  comment          String?
  decidedAt        DateTime?
  createdAt        DateTime         @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  approver       User?          @relation("Approver", fields: [approverId], references: [id])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadataJson   String   @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])
}

model ActivityEvent {
  id             String   @id @default(cuid())
  organizationId String
  type           String
  title          String
  description    String?
  metadataJson   String   @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// One GitHub code-analysis ingest per org (manual Sync now).
model CodeAnalysisRun {
  id                String   @id @default(cuid())
  organizationId    String
  integrationId     String
  repoFullNamesJson String   @default("[]")
  commitCount       Int      @default(0)
  prCount           Int      @default(0)
  summary           String?
  syncedAt          DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, syncedAt])
}

/// Normalized commit rows for drill-down and trend history (upserted per sync).
model CodeAnalysisCommit {
  id             String   @id @default(cuid())
  organizationId String
  sha            String
  repo           String
  message        String
  author         String
  committedAt    DateTime
  url            String
  additions      Int      @default(0)
  deletions      Int      @default(0)
  attribution    String
  confidence     Int      @default(0)
  signalsJson    String   @default("[]")
  lastSeenAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, repo, sha])
  @@index([organizationId, committedAt])
}

/// Normalized merged PR rows for drill-down and governance metrics.
model CodeAnalysisPullRequest {
  id             String   @id @default(cuid())
  organizationId String
  externalId     String
  number         Int
  title          String
  repo           String
  author         String
  mergedAt       DateTime
  url            String
  linesAdded     Int      @default(0)
  linesRemoved   Int      @default(0)
  attribution    String
  confidence     Int      @default(0)
  reviewCount    Int      @default(0)
  toolsJson      String   @default("[]")
  lastSeenAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalId])
  @@index([organizationId, mergedAt])
}

/// Computed delivery-analysis rollup per Jira sync (portfolio scope, for trends and deltas).
model DeliveryAnalysisSnapshot {
  id              String   @id @default(cuid())
  organizationId  String
  integrationId   String?
  healthScore     Int
  openWork        Int
  blocked         Int      @default(0)
  overdue         Int      @default(0)
  bugsOpen        Int      @default(0)
  projectKeysJson String   @default("[]")
  snapshotJson    String
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, syncedAt])
}
