generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ORG_ADMIN
  DELIVERY_MANAGER
  ENGINEERING_MANAGER
  QA_LEAD
  DEVOPS_LEAD
  DEVELOPER
  VIEWER
  COMPLIANCE_OFFICER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AutonomyMode {
  OBSERVE
  RECOMMEND
  ASSIST
  SEMI_AUTONOMOUS
  AUTONOMOUS
}

enum IntegrationProvider {
  GITHUB
  JIRA
  JENKINS
  GRAFANA
  PROMETHEUS
  SLACK
  AWS
}

enum TelemetryEventType {
  DEPLOYMENT
  CICD
  RELEASE
  OBSERVABILITY
  AI_RUNTIME
  WEBHOOK
  CUSTOM
}

enum TelemetrySeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

enum RecommendationStatus {
  PENDING
  APPROVED
  REJECTED
  MODIFIED
}

/// UX lane: SETUP/OPS never create leadership Approvals; RELEASE_GATE/GOVERNANCE do.
enum RecommendationQueue {
  SETUP
  OPS
  RELEASE_GATE
  GOVERNANCE
}

enum ApprovalType {
  RECOMMENDATION
  AGENT_ACTION
}

enum RecommendationImpact {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  MODIFIED
}

enum WorkspaceMode {
  MVP
  ENTERPRISE
}

model Organization {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  industry      String?
  workspaceMode WorkspaceMode @default(ENTERPRISE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  users              User[]
  profile            OrganizationProfile?
  deliveryDna        DeliveryDNA?
  integrations       Integration[]
  recommendations    Recommendation[]
  approvals          Approval[]
  auditLogs          AuditLog[]
  activityEvents     ActivityEvent[]
  acceleratorProjects AcceleratorProject[]
  releases           Release[]
  deliveryWorkflow   DeliveryWorkflow?
  incidents          Incident[]
  incidentCodeLinks  IncidentCodeLink[]
  telemetryMetrics   TelemetryMetric[]
  telemetryEvents    TelemetryEvent[]
  deploymentEvents   DeploymentEvent[]
  webhookEvents      WebhookEvent[]
  invitations        OrgInvitation[]
  governancePolicy   GovernancePolicy?
  codeAnalysisRuns   CodeAnalysisRun[]
  codeAnalysisCommits CodeAnalysisCommit[]
  codeAnalysisPullRequests CodeAnalysisPullRequest[]
  integrationConnectInvites IntegrationConnectInvite[]
  deliveryAnalysisSnapshots DeliveryAnalysisSnapshot[]
  complianceRuleStates     ComplianceRuleState[]
  complianceFindings       ComplianceFinding[]
  problemPredictions       ProblemPrediction[]
  agentChatThreads         AgentChatThread[]
  agentChatMessages        AgentChatMessage[]
  executiveBriefingSnapshots ExecutiveBriefingSnapshot[]
  jiraCalibrationProfiles JiraCalibrationProfile[]
  embeddings              Embedding[]
  ticketSnapshots         TicketSnapshot[]
  commitSnapshots         CommitSnapshot[]
  evidenceLinks           EvidenceLink[]
  evidenceReviews         EvidenceReview[]
}

enum EmbeddingRefType {
  commit
  ticket
}

enum EvidenceTier {
  direct
  strong
  moderate
  reviewable
  low
}

enum EvidenceReviewDecision {
  confirmed
  rejected
}

enum MetricSource {
  PROMETHEUS
  GRAFANA
  OPENTELEMETRY
  SYNTHETIC
}

enum DeploymentHealth {
  HEALTHY
  DEGRADED
  FAILED
}

/// Timescale hypertable (partition: recordedAt). Composite PK required by Timescale.
model TelemetryMetric {
  id             String       @default(cuid())
  organizationId String
  releaseId      String?
  source         MetricSource
  metricKey      String
  value          Float
  unit           String?
  labelsJson     Json         @default("{}")
  recordedAt     DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  release      Release?     @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@id([id, recordedAt])
  @@index([organizationId, recordedAt])
  @@index([releaseId])
}

/// Timescale hypertable (partition: occurredAt). Composite PK required by Timescale.
model TelemetryEvent {
  id             String             @default(cuid())
  organizationId String
  eventType      TelemetryEventType
  source         String
  severity       TelemetrySeverity  @default(INFO)
  environment    String?
  service        String?
  releaseId      String?
  correlationId  String?
  normalizedJson Json               @default("{}")
  payloadJson    Json               @default("{}")
  occurredAt     DateTime
  ingestedAt     DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  release      Release?     @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@id([id, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([eventType])
  @@index([correlationId])
}

/// Timescale hypertable (partition: receivedAt). Prefer updateMany by id (no single-column unique).
model WebhookEvent {
  id             String              @default(cuid())
  organizationId String
  provider       IntegrationProvider
  eventType      String
  status         WebhookEventStatus  @default(RECEIVED)
  payloadJson    Json
  retryCount     Int                 @default(0)
  lastError      String?
  processedAt    DateTime?
  receivedAt     DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([id, receivedAt])
  @@index([organizationId, receivedAt])
  @@index([status])
}

model OrgInvitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           UserRole @default(VIEWER)
  invitedById    String
  token          String   @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
}

model GovernancePolicy {
  id                    String   @id @default(cuid())
  organizationId        String   @unique
  deploymentThresholds  Json     @default("{}")
  releaseRulesJson      Json     @default("{}")
  approvalRequirements  Json     @default("{}")
  escalationChainsJson  Json     @default("{}")
  approvalLevelLabelsJson Json   @default("{}")
  projectOverridesJson  Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Per-org (and optional per-project) enable/threshold overrides for seeded compliance rules.
model ComplianceRuleState {
  id             String   @id @default(cuid())
  organizationId String
  ruleKey        String
  projectKey     String?
  enabled        Boolean  @default(true)
  thresholdsJson Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, ruleKey, projectKey])
  @@index([organizationId])
}

/// Durable compliance findings from continuous rule evaluation.
model ComplianceFinding {
  id               String   @id @default(cuid())
  organizationId   String
  ruleKey          String
  dedupKey         String
  severity         String
  status           String   @default("open")
  targetType       String
  targetExternalId String
  projectKey       String?
  title            String
  detailJson       Json     @default("{}")
  entityLabel      String?
  entityUrl        String?
  repo             String?
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  resolvedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupKey])
  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@index([organizationId, ruleKey])
}

/// Forward-looking problem predictions from trend/threshold analysis across domains.
model ProblemPrediction {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  domain         String
  severity       String
  horizon        String
  confidence     Float
  status         String   @default("open")
  rationale      String
  signalsJson    Json     @default("{}")
  projectKey     String?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  resolvedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@index([organizationId, domain])
}

/// Timescale hypertable (partition: deployedAt). Composite PK required by Timescale.
model DeploymentEvent {
  id                  String           @default(cuid())
  organizationId      String
  releaseId           String?
  environment         ReleaseEnvironment @default(STAGING)
  health              DeploymentHealth @default(HEALTHY)
  healthScore         Int              @default(100)
  rollbackRecommended Boolean          @default(false)
  rollbackReason      String?
  durationMs          Int?
  notes               String?
  mergeCommitSha      String?
  pullRequestNumber   Int?
  deployedAt          DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  release      Release?     @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@id([id, deployedAt])
  @@index([organizationId, deployedAt])
}

enum WorkflowExecutionStatus {
  NOT_CONFIGURED
  ACTIVE
  PAUSED
  COMPLETED
}

enum AgentChatThreadStatus {
  open
  done
}

enum AgentChatMessageKind {
  human
  assistant
  system
  approval_request
  approval_resolved
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  REMEDIATED
  CLOSED
}

model DeliveryWorkflow {
  id                       String                    @id @default(cuid())
  organizationId           String                    @unique
  workflowType             String                    @default("enterprise-governed")
  executionStatus          WorkflowExecutionStatus   @default(NOT_CONFIGURED)
  currentStepId            String?
  stepsCompletedJson       Json                      @default("[]")
  configuredAt             DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Incident {
  id                   String         @id @default(cuid())
  organizationId       String
  releaseId            String?
  correlationId        String?
  source               MetricSource?
  title                String
  description          String?
  affectedServicesJson Json           @default("[]")
  severityScore        Int            @default(50)
  status               IncidentStatus @default(OPEN)
  remediationNotes     String?
  detectedAt           DateTime       @default(now())
  resolvedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  release      Release?     @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  codeLinks    IncidentCodeLink[]

  @@index([organizationId])
  @@index([correlationId])
}

model IncidentCodeLink {
  id                    String   @id @default(cuid())
  organizationId        String
  incidentId            String
  pullRequestExternalId String?
  commitSha             String?
  confidence            Float    @default(0.5)
  reason                String
  peopleJson            Json     @default("[]")
  createdAt             DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([organizationId, incidentId])
}

enum ReleaseEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum ReleaseStatus {
  DETECTED
  ASSESSED
  PENDING_APPROVAL
  APPROVED
  DEPLOYED
  BLOCKED
}

enum ReleaseRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PrimaryRecommendation {
  HOLD
  APPROVE_WITH_SIGNOFF
  APPROVE
}

model Release {
  id                   String              @id @default(cuid())
  organizationId       String
  name                 String
  version              String?
  branch               String?
  jiraFixVersion       String?
  jiraSprintId         Int?
  serviceScope         String?
  metadataJson         Json                @default("{}")
  environment          ReleaseEnvironment  @default(STAGING)
  status               ReleaseStatus       @default(DETECTED)
  governanceRiskScore  Float?
  readinessScore       Float?
  riskLevel            ReleaseRiskLevel?
  primaryRecommendation PrimaryRecommendation?
  qaSignalsJson        Json                @default("[]")
  telemetryJson        Json                @default("{}")
  testGapsJson         Json                @default("[]")
  regressionNotes      String?
  assessmentSummary    String?
  assessmentSnapshotJson Json              @default("{}")
  postDeployComparisonJson Json            @default("{}")
  detectedAt           DateTime            @default(now())
  assessedAt           DateTime?
  deployedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendations  Recommendation[]
  incidents        Incident[]
  telemetryMetrics TelemetryMetric[]
  telemetryEvents  TelemetryEvent[]
  deploymentEvents DeploymentEvent[]

  @@unique([organizationId, jiraSprintId])
  @@unique([organizationId, jiraFixVersion, serviceScope])
  @@index([organizationId])
}

enum AcceleratorStep {
  IDEA
  PRD
  ARCHITECTURE
  FEATURES
  JIRA_EPICS
  QA_PLAN
  DEPLOYMENT
  COMPLETE
}

enum AcceleratorStatus {
  DRAFT
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
}

model AcceleratorProject {
  id                    String            @id @default(cuid())
  organizationId        String
  title                 String
  idea                  String
  targetUser            String?
  problemStatement      String?
  currentStep           AcceleratorStep   @default(IDEA)
  status                AcceleratorStatus @default(DRAFT)
  prdMarkdown           String?
  architectureMarkdown  String?
  featuresJson          Json              @default("[]")
  jiraEpicsJson         Json              @default("[]")
  qaPlanMarkdown        String?
  deploymentPlanMarkdown String?
  roadmapJson           Json              @default("[]")
  createdById           String?
  approvedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id])

  @@index([organizationId])
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String
  passwordHash   String
  role           UserRole   @default(DEVELOPER)
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  organizationId String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvals      Approval[]   @relation("Approver")
  auditLogs      AuditLog[]
  acceleratorProjects   AcceleratorProject[]
  agentChatThreadsCreated AgentChatThread[] @relation("ChatThreadCreator")
  chatMessagesAuthored  AgentChatMessage[] @relation("ChatMessageAuthorUser")
}

model OrganizationProfile {
  id               String   @id @default(cuid())
  organizationId   String   @unique
  industryType     String?
  teamSize         String?
  sdlcMaturity     Int      @default(2)
  devopsMaturity   Int      @default(2)
  governanceLevel  Int      @default(2)
  complianceType   String?
  deploymentStrategy String?
  toolsJson        Json     @default("[]")
  workflowsJson    Json     @default("[]")
  toolchainMappingJson Json @default("{}")
  toolchainMappingConfirmedAt DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model JiraCalibrationProfile {
  id             String    @id @default(cuid())
  organizationId String
  projectKey     String
  status         String    @default("pending")
  windowDays     Int       @default(90)
  observedJson   Json      @default("{}")
  profileJson    Json      @default("{}")
  llmRationale   String?
  confidence     String?
  source         String    @default("deterministic")
  calibratedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, projectKey])
  @@index([organizationId])
}

model DeliveryDNA {
  id                String       @id @default(cuid())
  organizationId    String       @unique
  workflowMode      String
  approvalLevel     Int
  riskThreshold     Float
  autonomyMode      AutonomyMode @default(RECOMMEND)
  autonomyLevel     Int          @default(1)
  governanceScore   Int
  escalationMatrix  Json         @default("{}")
  observabilityStrategy String?
  summary           String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Integration {
  id                String              @id @default(cuid())
  organizationId    String
  provider          IntegrationProvider
  status            IntegrationStatus   @default(PENDING)
  displayName       String?
  metadataJson      Json                @default("{}")
  connectedAt       DateTime?
  lastSyncAt        DateTime?
  lastHealthCheckAt DateTime?
  lastError         String?
  webhookEnabled    Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

model IntegrationConnectInvite {
  id             String              @id @default(cuid())
  organizationId String
  provider       IntegrationProvider
  token          String              @unique
  createdById    String
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  revokedById    String?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider])
  @@index([expiresAt])
}

model Recommendation {
  id             String               @id @default(cuid())
  organizationId String
  releaseId      String?
  title          String
  description    String
  rationale      String
  impact         RecommendationImpact @default(MEDIUM)
  confidence     Float
  affectedSystems Json                @default("[]")
  requiredRole   UserRole?
  status         RecommendationStatus @default(PENDING)
  queue          RecommendationQueue  @default(OPS)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  release      Release?     @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  approvals    Approval[]

  @@index([organizationId, queue, status])
}

model Approval {
  id                 String            @id @default(cuid())
  organizationId     String
  type               ApprovalType      @default(RECOMMENDATION)
  recommendationId   String?
  title              String?
  payloadJson        Json              @default("{}")
  approverId         String?
  decision           ApprovalDecision?
  riskScore          Float?
  comment            String?
  decidedAt          DateTime?
  createdAt          DateTime          @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  approver       User?           @relation("Approver", fields: [approverId], references: [id])
  chatMessages   AgentChatMessage[]

  @@index([organizationId, type])
}

/// Timescale hypertable (partition: createdAt). Composite PK required by Timescale.
model AuditLog {
  id             String   @default(cuid())
  organizationId String
  userId         String?
  actorType      String?
  action         String
  entityType     String
  entityId       String?
  metadataJson   Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@id([id, createdAt])
  @@index([organizationId, createdAt])
}

/// Timescale hypertable (partition: createdAt). Composite PK required by Timescale.
model ActivityEvent {
  id             String   @default(cuid())
  organizationId String
  type           String
  title          String
  description    String?
  metadataJson   Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([id, createdAt])
  @@index([organizationId, createdAt])
}

/// One GitHub code-analysis ingest per org (manual Sync now).
model CodeAnalysisRun {
  id                String   @id @default(cuid())
  organizationId    String
  integrationId     String
  repoFullNamesJson Json     @default("[]")
  commitCount       Int      @default(0)
  prCount           Int      @default(0)
  summary           String?
  syncedAt          DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, syncedAt])
}

/// Normalized commit rows for drill-down and trend history (upserted per sync).
model CodeAnalysisCommit {
  id             String   @id @default(cuid())
  organizationId String
  sha            String
  repo           String
  message        String
  author         String
  committedAt    DateTime
  url            String
  additions      Int      @default(0)
  deletions      Int      @default(0)
  attribution    String
  confidence     Int      @default(0)
  signalsJson    Json     @default("[]")
  jiraKeysJson   Json     @default("[]")
  branch         String?
  completionScore Int?
  completionRationale String?
  lastSeenAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, repo, sha])
  @@index([organizationId, committedAt])
}

/// Normalized merged PR rows for drill-down and governance metrics.
model CodeAnalysisPullRequest {
  id             String   @id @default(cuid())
  organizationId String
  externalId     String
  number         Int
  title          String
  repo           String
  author         String
  mergedAt       DateTime
  url            String
  linesAdded     Int      @default(0)
  linesRemoved   Int      @default(0)
  attribution    String
  confidence     Int      @default(0)
  reviewCount    Int      @default(0)
  reviewersJson  Json     @default("[]")
  filesJson      Json     @default("[]")
  toolsJson      Json     @default("[]")
  jiraKeysJson   Json     @default("[]")
  diffExcerpt    String?
  completionScore Int?
  completionRationale String?
  riskScore      Int?
  riskLevel      String?
  qualityFlagsJson Json   @default("[]")
  lastSeenAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalId])
  @@index([organizationId, mergedAt])
}

/// Computed delivery-analysis rollup per Jira sync (portfolio scope, for trends and deltas).
model DeliveryAnalysisSnapshot {
  id              String   @id @default(cuid())
  organizationId  String
  integrationId   String?
  healthScore     Int
  openWork        Int
  blocked         Int      @default(0)
  overdue         Int      @default(0)
  bugsOpen        Int      @default(0)
  projectKeysJson Json     @default("[]")
  snapshotJson    Json
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, syncedAt])
}

model ExecutiveBriefingSnapshot {
  id             String   @id @default(cuid())
  organizationId String   @unique
  headlineJson   Json
  narrative      String
  source         String   @default("llm_enriched")
  factsHash      String?
  generatedAt    DateTime @default(now())
  expiresAt      DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, generatedAt])
}

model AgentChatThread {
  id                 String                   @id @default(cuid())
  organizationId     String
  title              String
  status             AgentChatThreadStatus    @default(open)
  contextSummary     String?
  createdByUserId    String?
  /// External channel source, e.g. "slack"
  externalSource     String?
  /// Platform thread key, e.g. "<channelId>:<threadTs>"
  externalThreadId   String?
  closedAt           DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  organization  Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User?                    @relation("ChatThreadCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  messages      AgentChatMessage[]

  @@unique([organizationId, externalSource, externalThreadId])
  @@index([organizationId, status, updatedAt])
}

model AgentChatMessage {
  id              String               @id @default(cuid())
  organizationId  String
  threadId        String
  kind            AgentChatMessageKind
  contentMarkdown String               @default("")
  reasoningJson   Json                 @default("{}")
  authorUserId    String?
  approvalId      String?
  feedback        String?
  createdAt       DateTime             @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  thread       AgentChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUser   User?           @relation("ChatMessageAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)
  approval     Approval?       @relation(fields: [approvalId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([organizationId, threadId])
}

/// 384-dim embedding row. The `vector` column is pgvector; read/write via raw SQL
/// helpers in `src/lib/ml/vector-store.ts` (Prisma Unsupported).
model Embedding {
  id             String           @id @default(cuid())
  organizationId String
  refType        EmbeddingRefType
  refId          String
  modelName      String
  dim            Int              @default(384)
  /// pgvector column — not readable via Prisma client; use vector-store helpers.
  vector         Unsupported("vector(384)")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, refType, refId, modelName])
  @@index([organizationId, refType])
}

/// Snapshot of a Jira ticket at evidence-compute time.
model TicketSnapshot {
  id              String    @id @default(cuid())
  organizationId  String
  jiraKey         String
  projectKey      String
  sprintId        String?
  summary         String?
  descriptionText String?
  assigneeName    String?
  reporterName    String?
  status          String?
  issueType       String?
  priority        String?
  labelsJson      Json      @default("[]")
  storyPoints     Float?
  ticketCreatedAt DateTime?
  ticketUpdatedAt DateTime?
  resolvedAt      DateTime?
  capturedAt      DateTime  @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidenceLinks EvidenceLink[]

  @@unique([organizationId, jiraKey, sprintId])
  @@index([organizationId, sprintId])
  @@index([organizationId, jiraKey])
}

/// Snapshot of a git commit at evidence-compute time.
model CommitSnapshot {
  id             String    @id @default(cuid())
  organizationId String
  sha            String
  repoFullName   String
  primaryBranch  String
  authorName     String?
  authorEmail    String?
  commitDate     DateTime?
  subject        String?
  body           String?
  filesTouchedJson Json    @default("[]")
  funcSignaturesJson Json  @default("[]")
  hunkSnippet    String?
  capturedAt     DateTime  @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidenceLinks EvidenceLink[]

  @@unique([organizationId, repoFullName, sha])
  @@index([organizationId, repoFullName])
  @@index([organizationId, commitDate])
}

/// Candidate ticket↔commit evidence link with per-signal scores.
model EvidenceLink {
  id               String       @id @default(cuid())
  organizationId   String
  ticketSnapshotId String
  commitSnapshotId String
  sprintId         String?
  tier             EvidenceTier
  authorScore      Float
  dateScore        Float
  keywordScore     Float
  codeSimScore     Float        @default(0)
  compositeScore   Float
  signalPattern    String
  computedAt       DateTime     @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketSnapshot TicketSnapshot  @relation(fields: [ticketSnapshotId], references: [id], onDelete: Cascade)
  commitSnapshot CommitSnapshot  @relation(fields: [commitSnapshotId], references: [id], onDelete: Cascade)
  review         EvidenceReview?

  @@unique([ticketSnapshotId, commitSnapshotId])
  @@index([organizationId, sprintId])
  @@index([ticketSnapshotId])
}

/// Human accept/reject of an evidence candidate.
model EvidenceReview {
  id             String                  @id @default(cuid())
  organizationId String
  evidenceLinkId String                  @unique
  reviewerId     String
  decision       EvidenceReviewDecision
  note           String?
  reviewedAt     DateTime                @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidenceLink EvidenceLink @relation(fields: [evidenceLinkId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum ProductivityAnalysisRunStatus {
  PERSISTED
  VERIFIED
  FAILED
}

enum ProductivityActivityDimension {
  WEEKDAY
  HOUR_IST
  COMMIT_SIZE_ADDED
}

enum ProductivityInsightKind {
  WENT_WELL
  RISK
  RECOMMENDATION
}

/// Parent row: one analyze-git JSON report persisted as normalized tables.
model ProductivityAnalysisRun {
  id             String @id @default(cuid())
  organizationId String

  repositoryName String
  repositoryUrl  String?
  branch         String

  reportPath     String
  reportSha256   String

  mastraRunId    String?
  mastraTraceId  String?
  mastraThreadId String?

  analyzedAt DateTime @default(now())
  status     ProductivityAnalysisRunStatus @default(PERSISTED)
  verifiedAt DateTime?
  verificationErrorsJson Json @default("[]")

  // Report.window flattening (YYYY-MM-DD → DateTime at midnight in local JS time).
  windowFirstCommit DateTime?
  windowLastCommit  DateTime?
  windowCalendarDays Int?
  windowActiveDays   Int?
  windowActiveIsoWeeks Int?

  // Report.headline flattening.
  headlineTotalCommits          Int?
  headlineMergeCommits         Int?
  headlineNonMergeCommits      Int?
  headlineFilesTouched         Int?
  headlineLinesAddedRaw        Int?
  headlineLinesDeletedRaw      Int?
  headlineLinesAddedProduct   Int?
  headlineLinesDeletedProduct Int?
  headlineNetGrowthRaw         Int?
  headlineNetGrowthProduct    Int?
  headlinePrsMerged            Int?

  headlineActiveDays Int?
  headlineCalendarDays Int?
  headlineAvgCommitsPerActiveDay Float?
  headlineAvgCommitsPerCalendarDay Float?

  headlineMedianCommitAdded Int?
  headlineMedianCommitDeleted Int?
  headlineMeanCommitAdded Int?
  headlineMeanCommitDeleted Int?
  headlineP90CommitAdded Int?
  headlineMaxCommitAdded Int?
  headlineFeatFixRatio Float?

  // Arrays from methodology_and_caveats + branching_and_delivery.
  strongestSignals String[]
  weakestSignals   String[]
  remoteBranches   String[]

  // Scalar fields from branching_and_delivery.
  devAheadOfMainCommits Int?
  mainAheadOfDevCommits Int?
  remoteBranchCount Int?

  // Scalar fields from methodology_and_caveats.
  tlDr String @default("")
  methodologyDataSource String?
  methodologyLocNote String?
  methodologyExclusionsNoisyFiles String?
  methodologyExclusionsGeneratedDirs String?

  contributors                    ProductivityContributorStat[]
  commitTypeBreakdown            ProductivityCommitTypeStat[]
  weeklyVolume                   ProductivityWeeklyVolume[]
  activityBuckets                ProductivityActivityBucket[]
  areaStats                      ProductivityAreaStat[]
  largeCommits                   ProductivityLargeCommit[]
  insights                       ProductivityInsight[]

  @@unique([organizationId, repositoryName, branch, reportSha256])
  @@index([organizationId, analyzedAt])
}

model ProductivityContributorStat {
  id             String @id @default(cuid())
  organizationId String
  runId          String

  authorName   String
  commits      Int
  sharePct     Float
  files        Int
  linesAdded   Int
  linesDeleted Int
  net           Int
  rank          Int?

  run ProductivityAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, authorName])
  @@index([organizationId, authorName])
}

model ProductivityCommitTypeStat {
  id             String @id @default(cuid())
  organizationId String
  runId          String

  commitType String
  count      Int
  sharePct   Float

  run ProductivityAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, commitType])
}

model ProductivityWeeklyVolume {
  id             String @id @default(cuid())
  organizationId String
  runId          String

  isoWeek String
  commits Int

  run ProductivityAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, isoWeek])
  @@index([organizationId, isoWeek])
}

model ProductivityActivityBucket {
  id             String @id @default(cuid())
  organizationId String
  runId          String

  dimension    ProductivityActivityDimension
  bucketKey    String
  bucketIndex  Int
  commits      Int

  run ProductivityAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, dimension, bucketKey])
  @@index([organizationId, dimension, bucketKey])
}

model ProductivityAreaStat {
  id             String @id @default(cuid())
  organizationId String
  runId          String

  area    String
  commits Int
  files   Int
  added   Int
  deleted Int
  net     Int
  rank    Int?

  run ProductivityAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, area])
  @@index([organizationId, area])
}

model ProductivityLargeCommit {
  id             String @id @default(cuid())
  organizationId String
  runId          String

  sha         String
  committedOn DateTime?
  authorName  String
  subject     String
  files       Int
  added       Int
  deleted     Int
  rank        Int?

  run ProductivityAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sha])
  @@index([organizationId, committedOn])
}

model ProductivityInsight {
  id             String @id @default(cuid())
  organizationId String
  runId          String

  kind  ProductivityInsightKind
  title String
  detail String
  rank Int

  run ProductivityAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, kind, rank])
  @@index([organizationId, kind])
}

